# Server Port (default: 3001)
PORT=3001

# 32-byte hex-encoded encryption key for customer service account credentials.
# Generate a new key using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# DeepSeek AI API Key for AI review response generation
DEEPSEEK_API_KEY=

# (Optional) Custom path to Firebase Admin Service Account Key JSON file
# Defaults to: ../../firebase-service-account.json relative to src/config/
FIREBASE_KEY_PATH=

# (Optional) Additional frontend origins allowed by CORS (comma-separated if multiple)
# Localhost development origins are automatically allowed.
ALLOWED_FRONTEND_ORIGIN=
