# ============================================================================
# REVIEWFORGE MONOREPO MASTER GITIGNORE
# Applies recursively to root, /frontend, and /customer-frontend
# ============================================================================

# Dependencies (Root, /frontend/node_modules, /customer-frontend/node_modules)
node_modules/
**/node_modules/

# Frontend Build Outputs (Vite dist folders)
dist/
dist-ssr/
**/dist/
**/dist-ssr/

# Environment Variables & Local Secret Files
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local
**/.env.*.local

# Google & Firebase Service Account Key JSON Files
service-account.json
firebase-service-account.json
*service-account*.json

# Security & Key Files
*.pem
*.key
*.p12

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System & OS Files
.DS_Store
Thumbs.db
**/.DS_Store

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo
